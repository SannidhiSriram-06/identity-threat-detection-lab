<!--
  Custom Wazuh Rules for Identity & Host Threat Detection Lab
  Rules mapped to MITRE ATT&CK: T1110, T1078, T1548, T1068
-->
<group name="identity_threat_lab,">

  <!-- ======================================================================== -->
  <!-- 1. SSH Brute-Force Detection (MITRE ATT&CK T1110: Brute Force)           -->
  <!-- ======================================================================== -->
  <rule id="100100" level="5">
    <if_sid>5710, 5716</if_sid>
    <description>Identity Lab: Single SSH authentication failure detected</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Identity Lab Alert: Possible SSH Brute Force Attack detected (Multiple failed logins in 60s)</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1110.003</id>
    </mitre>
    <group>authentication_failures,gdpr_IV_35.7.d,hipaa_164.312.b,</group>
  </rule>

  <!-- ======================================================================== -->
  <!-- 2. Privilege Escalation Detection (MITRE ATT&CK T1548: Abuse Elevation)  -->
  <!-- ======================================================================== -->
  <rule id="100200" level="7">
    <if_sid>5402</if_sid>
    <match>FAILED su|NOT in sudoers|incorrect password attempt</match>
    <description>Identity Lab Alert: Sudo authentication failure or unauthorized user attempted sudo execution</description>
    <mitre>
      <id>T1548.003</id>
      <id>T1078</id>
    </mitre>
    <group>privilege_escalation,syslog,sudo,</group>
  </rule>

  <rule id="100201" level="12" frequency="3" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <description>Identity Lab Alert: Multiple Privilege Escalation attempts detected (Repeated sudo/su violations)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,attacks,</group>
  </rule>

  <rule id="100202" level="10">
    <if_sid>5400</if_sid>
    <match>/etc/shadow|/etc/passwd|chmod +s|chown root</match>
    <description>Identity Lab Alert: Suspicious file access or SUID permission modification attempted</description>
    <mitre>
      <id>T1548.001</id>
      <id>T1003.008</id>
    </mitre>
    <group>privilege_escalation,file_integrity,</group>
  </rule>

  <!-- ======================================================================== -->
  <!-- 3. AWS CloudTrail & Vault Identity Anomalies (MITRE ATT&CK T1078.004)    -->
  <!-- ======================================================================== -->
  <rule id="100300" level="8">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^CreateAccessKey$|^CreateUser$</field>
    <description>Identity Lab Alert: CloudTrail detected IAM User or Permanent Access Key creation</description>
    <mitre>
      <id>T1078.004</id>
      <id>T1098</id>
    </mitre>
    <group>aws_iam,cloudtrail,</group>
  </rule>

  <rule id="100301" level="9">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^ConsoleLogin$</field>
    <field name="aws.additionalEventData.MFAUsed">^No$</field>
    <description>Identity Lab Alert: AWS Management Console login succeeded without MFA</description>
    <mitre>
      <id>T1078.004</id>
    </mitre>
    <group>aws_iam,cloudtrail,</group>
  </rule>

</group>
